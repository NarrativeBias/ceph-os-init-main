# Скопировать в group_vars/deployment.yaml рядом с инвентарём.
# Нужна группа [deployment] в инвентаре (Ansible подхватывает group_vars/<группа>.yaml по имени).
#
# Ceph ↔ ОС: 17.2.6|18.2.7 → 20.04; 19.2.6|20.2.4 → 24.04

local_registry: "d5example-mo5001lp.corp.dev.vtb:5000"
ceph_repo_ver: "19.2.6"
node_exporter_ver: "1.8.2"
ubuntu_version: "24.04"
cluster_name: "TEST-EXAMPLE"

# Backend CIDR на первом mon (cephadm). Не public/front-end /27, если это разные сети.
cluster_network: "0.0.0.0/27"

# По одному /27 на стойку → через запятую в ceph public_network
public_networks:
  - "0.0.0.0/27"
  # - "0.0.0.32/27"

# Архивы образов для плейбука 02 (*.{tar.gz,tar.zst}); по умолчанию = <repo>/registry-images
registry_images_dir: "{{ playbook_dir }}/../registry-images"
