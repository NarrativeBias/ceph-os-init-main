# Copy to group_vars/all.yml next to the inventory and replace the example values.
local_registry: "d5example-mo5001lp.corp.dev.vtb:5000"
# Ceph version: selects roles/ceph-packages/files/*<ver>*.deb and container tags
ceph_repo_ver: "19.2.1"
node_exporter_ver: "1.8.2"
# Target OS: Ubuntu 24.04 (noble)
ubuntu_codename: noble
cluster_name: "TEST-EXAMPLE"

# Registry image archives: roles/cluster-init/files/*.tar.gz
