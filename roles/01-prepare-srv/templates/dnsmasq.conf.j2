##########################################################
# This config from template dnsmasq playbook by pre init #
##########################################################

resolv-file=/etc/resolv.dnsmasq
no-poll
interface=lo
listen-address=127.0.0.1
bind-interfaces
cache-size=1000
no-negcache
conf-dir=/etc/dnsmasq.d,.rpmnew,.rpmsave,.rpmorig
all-servers

